# Nombres de los recursos. Editar antes de correr setup.sh / teardown.sh.
# Aqui NO van credenciales: la contrasena de RDS se genera sola y se guarda
# unicamente en AWS Secrets Manager.

export AWS_REGION="us-east-1"
export PROJECT="polaroid"

# S3: el nombre debe ser unico en todo AWS. Cambia el sufijo.
export BUCKET_NAME="polaroid-station-cambia-esto"

# RDS
export DB_INSTANCE_ID="polaroid-db"
export DB_INSTANCE_CLASS="db.t3.micro"
export DB_NAME="polaroids"
export DB_USER="admin"

# Secrets Manager
export SECRET_NAME="polaroid/rds"

# EC2
export EC2_NAME="polaroid-backend"
export INSTANCE_TYPE="t3.micro"
export KEY_NAME="polaroid-key"
export INSTANCE_PROFILE="LabInstanceProfile"
export APP_PORT="8000"

# Repositorio que la instancia clona al arrancar (debe ser publico)
export REPO_URL="https://github.com/TU-USUARIO/TU-REPO.git"
export REPO_BRANCH="main"
